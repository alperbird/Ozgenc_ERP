<Application x:Class="ERPClient.App"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:ERPClient"
            xmlns:local1="clr-namespace:ERPClient.ViewModel.COLOR">
   <Application.Resources>

       <!-- Ensure that the QuantityHighlightConverter class exists in the specified namespace -->
       <local1:QuantityHighlightConverter x:Key="QuantityHighlightConverter" />
       <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="15" ShadowDepth="5" Direction="270" Color="Black"/>

   </Application.Resources>
</Application>
