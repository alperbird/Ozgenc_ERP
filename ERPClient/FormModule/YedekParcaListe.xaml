<Window x:Class="ERPClient.FormModule.YedekParcaListe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ERPClient.FormModule"
        mc:Ignorable="d"
        Title="YedekParcaListe" Height="550" Width="400" Background="#F4F4F4"
        WindowState="Maximized" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Üst Menü -->
            <RowDefinition Height="*"/>
            <!-- İçerik -->
        </Grid.RowDefinitions>

        <!-- Üst Menü -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Background="#003366">
            <TextBlock Text="Parça Seçimi" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button x:Name="btnExit" Background="DarkRed" BorderThickness="0" Cursor="Hand" Click="btnExit_Click" HorizontalAlignment="Right" Margin="0,0,20,0" Width="100">
                <Image Source="/Assets/exit.png" Width="75" Height="44"/>
            </Button>
        </DockPanel>

        <!-- İçerik Alanı -->
        <StackPanel Grid.Row="1" Margin="20">
            <ListBox x:Name="lstParcalar" SelectionMode="Extended" Height="400"/>
            <Button Content="Tamam" Height="40" Width="100" Margin="0,20,0,0" TextElement.Foreground="White" Background="#003366" BorderThickness="0" 
                   Cursor="Hand" Click="BtnTamam_Click"/>
        </StackPanel>
    </Grid>
</Window>
