<Window x:Class="ERPClient.GenelModule.GeneralStockAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ERPClient.GenelModule"
        mc:Ignorable="d"
        Title="GeneralStockAddWindow" Height="600" Width="800" Background="#F4F4F4"
         WindowStyle="None" WindowStartupLocation="CenterScreen">
<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/> <!-- Üst Menü -->
            <RowDefinition Height="*"/>  <!-- Form İçeriği -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Sol Menü (ileriye yatırım) -->
            <ColumnDefinition Width="*"/>    <!-- İçerik -->
        </Grid.ColumnDefinitions>

        <!-- ÜST MENÜ -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Background="#003366">
            <TextBlock Text="Genel Parça Stok Ekleme Sayfası" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button x:Name="btnExit" Background="DarkRed" BorderThickness="0" Cursor="Hand" Click="btnExit_Click" HorizontalAlignment="Right" Margin="0,0,20,0" Width="100">
                <Image Source="/Assets/exit.png" Width="75" Height="44"/>
            </Button>
        </DockPanel>

        <!-- FORM ALANI -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Malzeme -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Malzeme:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PartList}" SelectedItem="{Binding SelectedPart, Mode=TwoWay}" DisplayMemberPath="F_MalzemeAdi" 
                      IsEditable="True" Text="{Binding PartSearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Tedarikçi -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tedarikçi:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SupplierList}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" DisplayMemberPath="F_TedarikciAdi" 
                      IsEditable="True" Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Depo -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Depo/Bölüm:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding WarehouseList}" SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}" DisplayMemberPath="DepoAdi" 
                      IsEditable="True" Text="{Binding WarehouseSearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Sipariş Tarihi -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Sipariş Tarihi:" VerticalAlignment="Center" Margin="0,5"/>
            <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding OrderDate}" />

            <!-- Giriş Tarihi -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Giriş Tarihi:" VerticalAlignment="Center" Margin="0,5"/>
            <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding DeliveryDate}" />

            <!-- Sipariş Adedi -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Sipariş Adedi:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OrderedQuantity}" />

            <!-- Gelen Adet -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Gelen Adet:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ReceivedQuantity}" />

            <!-- BUTONLAR -->
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Kaydet" Foreground="White" Width="100" Margin="5" Background="Green" BorderThickness="0" Cursor="Hand" Command="{Binding SaveCommand}" />
                <!--<Button Content="Vazgeç" Foreground="White" Width="100" Margin="5" Background="DarkRed" BorderThickness="0" Cursor="Hand" Click="btnVazgec_Click" />-->
            </StackPanel>
        </Grid>
    </Grid>
</Window>
