<Window x:Class="ERPClient.MusteriModule.CountryCRUDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CountryCRUDWindow" Height="600" Width="1000" Background="#F4F4F4"
        WindowState="Maximized" WindowStyle="None" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Ülke Ekleme Formu -->
            <RowDefinition Height="*"/>
            <!-- Liste -->
        </Grid.RowDefinitions>

        <!-- Üst Panel -->
        <DockPanel Grid.Row="0" Background="#003366" Height="50">
            <TextBlock Text="Ülke CRUD İşlemleri" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Background="DarkRed" BorderThickness="0" Cursor="Hand"
                    HorizontalAlignment="Right" Margin="0,0,20,0" Width="100" Click="btnBack_Click">
                <Image Source="/Assets/exit.png" Width="75" Height="44"/>
            </Button>
        </DockPanel>

        <!-- Ülke Ekleme Alanı -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,20,0,10">
            <TextBox x:Name="txtCountryName" Width="300" Height="30" FontSize="14"
             VerticalContentAlignment="Center" Margin="0,0,10,0" />

            <Button Content="➕"
            Width="100" Height="35" Margin="0,0,10,0"
            Background="#28a745" Foreground="White"
            FontWeight="Bold" FontSize="14"
            Cursor="Hand" BorderThickness="0"
            Click="btnAdd_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="✏️"
            Width="100" Height="35" Margin="0,0,10,0"
            Background="#ffc107" Foreground="Black"
            FontWeight="Bold" FontSize="14"
            Cursor="Hand" BorderThickness="0"
            Click="btnUpdate_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="🗑️"
            Width="100" Height="35"
            Background="#dc3545" Foreground="White"
            FontWeight="Bold" FontSize="14"
            Cursor="Hand" BorderThickness="0"
            Click="btnDelete_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>


        <!-- Ülke Listesi -->
        <ListBox x:Name="lstCountries" Grid.Row="2"
                 DisplayMemberPath="CountryName"
                 Margin="20,0,20,20"
                 FontSize="14"
                 SelectionChanged="lstCountries_SelectionChanged"/>
    </Grid>
</Window>
