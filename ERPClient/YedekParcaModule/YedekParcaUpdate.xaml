<Page x:Class="ERPClient.YedekParcaModule.YedekParcaUpdate"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ERPClient.YedekParcaModule"
      mc:Ignorable="d" 
      Background="#F4F4F4" Height="600" Width="800"
      >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Header -->
        <DockPanel Grid.Row="0" Background="#003366" Height="50">
            <TextBlock Text="Yedek Parça Güncelleme" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Name="btnBack" Background="DarkRed" BorderThickness="0" Cursor="Hand" Click="btnBack_Click"
                    HorizontalAlignment="Right" Margin="0,0,20,0" Width="50" Height="50">
                <Image Source="/Assets/exit.png" Width="30" Height="30"/>
            </Button>
        </DockPanel>

        <!-- Güncelleme Formu -->
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="Makine:" FontWeight="Bold"/>
            <ListBox Name="lstMakine" Width="250" Height="100" Margin="0,5,0,10"
                     SelectionMode="Multiple" DisplayMemberPath="MakineAdi" SelectedValuePath="Id"/>

            <TextBlock Text="Sınıf:" FontWeight="Bold"/>
            <ComboBox Name="cmbSinif" Width="250" Margin="0,5,0,10"/>


            <TextBlock Text="Parça Adı:" FontWeight="Bold"/>
            <TextBox Name="txtParcaAdi" Width="250" Margin="0,5,0,10"/>

            <TextBlock Text="Fiyat (TL):" FontWeight="Bold"/>
            <TextBox Name="txtTL" Width="250" Margin="0,5,0,10"/>

            <TextBlock Text="Fiyat (EUR):" FontWeight="Bold"/>
            <TextBox Name="txtEUR" Width="250" Margin="0,5,0,10"/>

            <!-- Güncelle Butonu -->
            <Button Content="💾 Güncelle" Width="150" Height="40" Background="#007ACC" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Margin="10,20,0,10" Click="btnUpdateSave_Click"/>
        </StackPanel>
    </Grid>
</Page>
