<Window x:Class="ERPClient.YedekParca"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ERPClient"
        mc:Ignorable="d"
        Title="YedekParca" Height="{x:Static SystemParameters.PrimaryScreenHeight}" Width="{x:Static SystemParameters.PrimaryScreenWidth}" Background="#F4F4F4"
        WindowState="Maximized" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Üst Header -->
            <RowDefinition Height="*"/>
            <!-- İçerik -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5000*" />
            <!-- DataGrid -->
            <ColumnDefinition Width="1.5*"/>
            <!-- Sağ Taraf -->
        </Grid.ColumnDefinitions>

        <!-- Üst Header -->
        <DockPanel Grid.Row="0" Background="#003366" Height="50">
            <TextBlock Text="Yedek Parça Yönetimi" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Background="DarkRed" BorderThickness="0" Cursor="Hand" Click="btnClose_Click" HorizontalAlignment="Right" Margin="0,0,20,0" Width="100">
                <Image Source="/Assets/exit.png" Width="75" Height="44"/>
            </Button>
        </DockPanel>

        <!-- İçerik Bölümü -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!--Arama Çubuğu-->

            <!-- Yedek Parça Listesi (Sol Taraf) -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Yedek Parçalar" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <!-- Arama Çubuğu -->
                <Border Grid.Column="0" Margin="10" Padding="5" Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="15" Width="300">
                    <DockPanel>
                        <!-- Arama Metin Kutusu -->
                        <TextBox x:Name="txtSearch" Width="250" Height="35" FontSize="14"
                            BorderThickness="0" Background="Transparent"
                            TextChanged="txtSearch_TextChanged"
                            KeyDown="txtSearch_KeyDown"/>

                        <!-- Arama Butonu -->
                        <Button Width="40" Height="35" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnSearch_Click">
                            <Image Source="/Assets/magnifying.png" Width="30" Height="30"/>

                        </Button>

                    </DockPanel>

                </Border>
                <ContentControl x:Name="MainContent" Grid.Row="1" Grid.Column="0"/>
                <DataGrid x:Name="dgYedekParca" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Visibility="Visible"
                          Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionMode="Single" SelectionUnit="FullRow"
                          BorderBrush="#003366" BorderThickness="1" RowHeight="63" SelectionChanged="dgYedekParca_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Makineler" Binding="{Binding MakineAdlari}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="FontSize" Value="10"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sınıf" Binding="{Binding Sinif}" Width="150"/>
                        <DataGridTemplateColumn Header="Fotoğraf" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="50" Height="50"
                                    Cursor="Hand"
                                    Source="{Binding ThumbnailImage, FallbackValue=/Assets/image.png}"
                                    PreviewMouseDown="Photo_PreviewMouseDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Parça Adı" Binding="{Binding ParcaAdi}" Width="*"/>
                        <DataGridTextColumn Header="Fiyat (TL)" Binding="{Binding FiyatTL}" Width="100"/>
                        <DataGridTextColumn Header="Fiyat (EUR)" Binding="{Binding FiyatEUR}" Width="100"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="FontSize" Value="10"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Güncelle Butonu -->
                        <DataGridTemplateColumn Header="Güncelle" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button  Width="Auto" Height="Auto" Background="LightSkyBlue" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="btnUpdate_Click">
                                        <Image Source="/Assets/update.png" Width="30" Height="30"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Sil" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="Auto" Height="Auto" Background="#CC0000" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="btnDelete_Click" Tag="{Binding}">
                                        <Image Source="/Assets/delete.png" Width="30" Height="30" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button x:Name="btnPrevious" Content="◀ Önceki" Click="btnPrevious_Click" Padding="5,2" Margin="5,0"/>
                    <TextBlock x:Name="txtPageInfo" Text="Sayfa 1" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button x:Name="btnNext" Content="Sonraki ▶" Click="btnNext_Click" Padding="5,2" Margin="5,0"/>
                </StackPanel>

            </StackPanel>

            <!-- Sağ Taraf: Yeni Yedek Parça Ekleme -->
            <Border Grid.Column="1" Padding="20" Margin="20" Background="#F4F4F4" BorderBrush="#CCC" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <!-- Başlık ve İkon -->
                    <Image Source="/Assets/spareparts.png" Height="120" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Yeni Yedek Parça Ekle" FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Makine Adı -->
                    <TextBlock Text="Makine:" FontWeight="Bold"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <ListBox Name="lstMakine" Width="250" Margin="0,5,0,10"
                     ItemsSource="{Binding Machines}"
                     DisplayMemberPath="MakineAdi" 
                     SelectedValuePath="Id" 
                     SelectionMode="Multiple"/>
                    </ScrollViewer>

                    <!-- Sınıf -->
                    <TextBlock Text="Sınıf:" FontWeight="Bold"/>
                    <ComboBox Name="cmbSinif" Width="250" Margin="0,5,0,10" SelectionChanged="cmbSinif_SelectionChanged"/>


                    <!-- Parça Adı -->
                    <TextBlock Text="Parça Adı:" FontWeight="Bold"/>
                    <TextBox Name="txtParcaAdi" Width="250" Margin="0,5,0,10" AcceptsReturn="True"/>

                    <!--Parça Adı (İngilizce)-->
                    <TextBlock Text="Parça Adı (İngilizce):" FontWeight="Bold"/>
                    <TextBox Name="txtEnglishProduct" Width="250" Margin="0,5,0,10" AcceptsReturn="True"/>

                    <!-- Fiyat TL -->
                    <TextBlock Text="Fiyat (TL):" FontWeight="Bold"/>
                    <TextBox Name="txtTL" Width="250" Margin="0,5,0,10"/>

                    <!-- Fiyat EUR -->
                    <TextBlock Text="Fiyat (EUR):" FontWeight="Bold"/>
                    <TextBox Name="txtEUR" Width="250" Margin="0,5,0,10"/>

                    <TextBlock Text="Parça Açıklaması:" FontWeight="Bold"/>
                    <TextBox Name="txtAciklama" Width="250" Margin="0,5,0,10" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <!--<Button Width="150" Height="30" Click="btnExcel_Click" Cursor="Hand" Content="Buna BASMA" Background="#FFC62929"/>-->

                    <TextBlock x:Name="txtFileName" Text="Dosya seçilmedi" FontWeight="Bold" TextAlignment="Center" Margin="5"/>

                    <!-- Fotoğraf Seçme Butonu -->
                    <Button Content="Fotoğraf Seç" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Background="#007BFF" Foreground="White" Padding="5,2" Cursor="Hand"
                            Click="btnSelectPhoto_Click"/>
                    <Image x:Name="imgPreview"
                            Width="1"
                            Height="1"
                            Stretch="UniformToFill"
                            Margin="10"
                            Visibility="Visible"/>

                    <!-- Ekle Butonu -->
                    <Button Content="➕ Ekle" Width="150" Height="40" Background="#28A745" Foreground="White"
                BorderThickness="0" Cursor="Hand" Margin="10,-15,0,10" Click="btnAdd_Click"/>

                    <!--<BU BUTON SADECE TABLOYU EXCEL FORMATINA ÇEVİRMEK İÇİN VARDIR.-->
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
