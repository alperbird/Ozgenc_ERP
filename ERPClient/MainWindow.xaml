<Window x:Class="ERPClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ERPClient"
        mc:Ignorable="d"
        Title="Özgenç ERP" Height="{x:Static SystemParameters.PrimaryScreenHeight}" Width="{x:Static SystemParameters.PrimaryScreenWidth}" Background="#F4F4F4"
        WindowState="Maximized" WindowStyle="None" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="DropdownMenuItemStyle" TargetType="MenuItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#003366"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#EEE"/>
        </Style>
        <Style TargetType="Button" x:Key="SidebarButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter x:Name="content" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0DDF6"/>
                                <Setter TargetName="content" Property="TextElement.Foreground" Value="#003366"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Satır ve Sütun Tanımlamaları -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Üst Menü -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Background="#003366">
            <Button Name="btnMenuToggle" Content="☰" Width="50" Height="40" Background="Transparent" Foreground="White" 
                    BorderThickness="0" Cursor="Hand" Click="btnMenuToggle_Click"/>
            <TextBlock Text="Özgenç ERP" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock Name="txtWelcome"
           Text=""
           FontSize="14"
           Foreground="White"
           VerticalAlignment="Center"
           HorizontalAlignment="Right"
           Margin="500,0,10,0"/>
            <Button x:Name="btnSettings" Width="40" Height="40"  Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="btnSettings_Click">
                <Image Source="/Assets/settings.png" Width="50" Height="30"/>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Kullanıcı Ayarları" Click="MenuItem_Profile_Click">
                            <MenuItem.Icon>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/user.png" Width="18" Height="18" Margin="0,0,5,0"/>
                                </StackPanel>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Test Sayfası" Click="MenuItem_Log_Click">
                            <MenuItem.Icon>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/lock.png" Width="18" Height="18" Margin="0,0,5,0"/>
                                </StackPanel>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Çıkış" Click="MenuItem_Logout_Click">
                            <MenuItem.Icon>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/exit.png" Width="18" Height="18" Margin="0,0,5,0"/>
                                </StackPanel>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

        </DockPanel>

        <!-- Sol Menü -->
        <Border Name="MenuPanel" Background="#EEE" Width="200" Visibility="Collapsed" Grid.Row="1">
            <StackPanel>
                <Button Style="{StaticResource SidebarButtonStyle}" BorderThickness="0" Click="btnToggleTree_Click" Tag="treeSpareParts">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/spareparts.png" Width="30" Height="30" Margin="0,0,5,0"/>
                        <TextBlock Text="Yedek Parça" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <TreeView Name="treeSpareParts" Background="#EEE" Visibility="Collapsed">
                    <TreeViewItem Header="Yedek Parça" Padding="5" Margin="5" Background="#EEE" BorderThickness="0">
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="TextBlock_Click">
                                    <Image Source="/Assets/list.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Yedek Parça Listesi" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="Stok_Click">
                                    <Image Source="/Assets/list.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Stok Takip" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                    </TreeViewItem>
                    
                </TreeView>
                
                <Button Style="{StaticResource SidebarButtonStyle}" BorderThickness="0" Click="btnToggleTree_Click" Tag="treeSales">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/sales.png" Width="30" Height="30" Margin="0,0,5,0"/>
                        <TextBlock Text="Satış" FontSize="16" FontWeight="Bold" Margin="0,0,53,0"/>
                    </StackPanel>
                </Button>
                <TreeView Name="treeSales" Background="#EEE" Visibility="Collapsed">
                    <TreeViewItem Header="Siparişler">
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="Yurtİci_PreviewMouseDown">
                                    <Image Source="/Assets/order.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Yurt İçi Sipariş" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="YurtDisi_PreviewMouseDown">
                                    <Image Source="/Assets/order.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Yurt Dışı Sipariş" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>


                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="SiparisGecmisi_PreviewMouseDown">
                                    <Image Source="/Assets/orderhistory.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Sipariş Geçmişi" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                    </TreeViewItem>
                    <TreeViewItem Header="Müşteriler">
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="TextBlockMusteri_Click">
                                    <Image Source="/Assets/addcustomer.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Müşteri Listesi" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                    </TreeViewItem>

                </TreeView>

                <Button Style="{StaticResource SidebarButtonStyle}" BorderThickness="0" Click="btnToggleTree_Click" Tag="treeForms">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/list.png" Width="30" Height="30" Margin="0,0,5,0"/>
                        <TextBlock Text="Teklif/İş-İstek" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <TreeView Name="treeForms" Background="#EEE" Visibility="Collapsed">
                    <TreeViewItem Header="Formlar">
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="TeklifFormu_PreviewMouseDown">
                                    <Image Source="/Assets/add.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Teklif Oluşturma" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="IsEmriFormu_PreviewMouseDown">
                                    <Image Source="/Assets/add.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Malzeme İstek Formu" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>

                <Button Style="{StaticResource SidebarButtonStyle}" BorderThickness="0" Click="btnToggleTree_Click" Tag="treeReports">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/filter.png" Width="30" Height="30" Margin="0,0,5,0"/>
                        <TextBlock Text="Stok Girişi" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <TreeView Name="treeReports" Background="#EEE" Visibility="Collapsed">
                    <TreeViewItem Header="Fabrika İçi">
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" PreviewMouseDown="Test1_PreviewMouseDown">
                                    <Image Source="/Assets/add.png" Width="30" Height="30" Margin="0,0,5,0"/>
                                    <TextBlock Text="Genel Parça Stokları" Foreground="Black" Cursor="Hand"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>
            </StackPanel>


        </Border>

        <!-- İçerik Alanı -->
        <Border Grid.Row="1" Grid.Column="1" Padding="10" Background="Transparent">
            <Grid>
                <!-- Kaydırılabilir görsel alanı --><!--
                <Grid ClipToBounds="True">
                    <Canvas x:Name="ImageCanvas">
                        <Image x:Name="imgSlider"
                       Width="600" Height="300"
                       Stretch="UniformToFill"
                       Canvas.Left="0"/>
                    </Canvas>
                </Grid>

                --><!-- Önceki/Sonraki butonlar --><!--
                <Button Content="◀" Width="30" Height="30"
                Click="BtnPrev_Click"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10"/>
                <Button Content="▶" Width="30" Height="30"
                Click="BtnNext_Click"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10"/>-->

                <!-- ERP İçeriğin -->
                <ContentControl x:Name="ContentArea" Panel.ZIndex="2"/>
            </Grid>
        </Border>

    </Grid>
    

</Window>