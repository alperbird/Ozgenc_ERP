<Window x:Class="ERPClient.StokModule.StokYonetim"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ERPClient.StokModule"
        mc:Ignorable="d"
        Title="StokYonetim" Height="{x:Static SystemParameters.PrimaryScreenHeight}" Width="{x:Static SystemParameters.PrimaryScreenWidth}" Background="#F4F4F4"
        WindowState="Maximized" WindowStyle="None" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Üst Header -->
            <RowDefinition Height="*"/>
            <!-- İçerik -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <!-- DataGrid -->
            <ColumnDefinition Width="1.5*"/>
            <!-- Sağ taraf -->
        </Grid.ColumnDefinitions>

        <!-- Üst Header -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Background="#003366" Height="50">
            <TextBlock Text="Yedek Parça – Stok Yönetimi" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Background="DarkRed" BorderThickness="0" Cursor="Hand" Click="btnBack_Click"
                    HorizontalAlignment="Right" Margin="0,0,20,0" Width="100">
                <Image Source="/Assets/exit.png" Width="75" Height="44"/>
            </Button>
        </DockPanel>

        <!-- SOL TARAF: DataGrid -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="20">
            <DataGrid x:Name="dgStoklar"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeight="35"
                      Margin="0,0,0,10"
                      ItemsSource="{Binding PagedProducts}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Parça Adı" Binding="{Binding ParcaAdi}" Width="3*" />
                    <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="1*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Pagination -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="◀ Geri" Click="BtnPrevPage_Click" Margin="10"/>
                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button Content="İleri ▶" Click="BtnNextPage_Click" Margin="10"/>
            </StackPanel>
        </StackPanel>

        <!-- SAĞ TARAF: ComboBox + TextBox + Butonlar -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="20" VerticalAlignment="Top">
            <TextBlock Text="Parça Seç" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbParcalar"
                      IsEditable="True"
                      StaysOpenOnEdit="True"
                      IsTextSearchEnabled="False"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding FilteredProducts}"
                      DisplayMemberPath="ParcaAdi"
                      SelectedItem="{Binding SelectedProduct}" 
                      Margin="0,0,0,15" Height="30"/>

            <TextBlock Text="Stok Miktarı" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtStokMiktar" Height="30" Margin="0,0,0,15" />

            <Button Content="➕ Stok Ekle" Height="35" Margin="0,0,0,10" Click="BtnStokEkle_Click"/>
            <Button Content="➖ Stok Azalt" Height="35" Click="BtnStokAzalt_Click"/>
            <TextBlock x:Name="txtUyari"
           Text=""
           FontSize="14"
           FontWeight="Bold"
           Foreground="Red"
           Visibility="Collapsed"
           HorizontalAlignment="Center"
           Margin="0,10,0,10"
           Grid.Row="1"
           Grid.ColumnSpan="2"/>
        </StackPanel>
    </Grid>
</Window>
