<Window x:Class="ERPClient.SiparisModule.SiparisDetay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ERPClient.SiparisModule"
        mc:Ignorable="d"
        Title="SiparisDetay" Height="{x:Static SystemParameters.PrimaryScreenHeight}" Width="{x:Static SystemParameters.PrimaryScreenWidth}" Background="#F4F4F4"
        WindowState="Maximized" WindowStyle="None" WindowStartupLocation="CenterScreen">

    <Grid Grid.Row="1" >
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Background="#003366" Height="50">
            <TextBlock Text="Sipariş Detayları" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Background="DarkRed" BorderThickness="0" Cursor="Hand" Click="btnBack_Click"
                    HorizontalAlignment="Right" Margin="0,0,20,0" Width="100">
                <Image Source="/Assets/exit.png" Width="75" Height="44"/>
            </Button>
        </DockPanel>


        <!-- MÜŞTERİ & SİPARİŞ BİLGİLERİ -->
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="Müşteri Bilgileri" FontWeight="Bold" FontSize="16" Margin="0 0 0 10"/>
            <WrapPanel>
                <TextBlock Text="Adı: " FontWeight="Bold"/>
                <TextBlock x:Name="txtCustomerName" Margin="5,0,20,0"/>
                <TextBlock Text="Ülke: " FontWeight="Bold"/>
                <TextBlock x:Name="txtCountry" Margin="5,0,20,0"/>
                <TextBlock Text="Vergi No: " FontWeight="Bold"/>
                <TextBlock x:Name="txtTaxNo" Margin="5,0,20,0"/>
            </WrapPanel>

            <WrapPanel>
                <TextBlock Text="Adres: " FontWeight="Bold"/>
                <TextBox x:Name="txtAddress" Margin="5,0,20,0" Width="200"/>
                <TextBlock Text="Teslimat Adresi: " FontWeight="Bold"/>
                <TextBox x:Name="txtDeliveryAddress" Margin="5,0,20,0" Width="200"/>
            </WrapPanel>

            <WrapPanel>
                <TextBlock Text="İlgili Kişi: " FontWeight="Bold"/>
                <TextBlock x:Name="txtContact" Margin="5,0,20,0"/>

                <TextBlock Text="Telefon: " FontWeight="Bold"/>
                <TextBlock x:Name="txtPhone" Margin="5,0,20,0"/>
                
                <TextBlock Text="Email: " FontWeight="Bold"/>
                <TextBlock x:Name="txtEmail" Margin="5,0,20,0"/>
            </WrapPanel>

            <WrapPanel>
                <TextBlock Text="Sipariş Tarihi: " FontWeight="Bold"/>
                <TextBlock x:Name="txtOrderDate" Margin="5,0,20,0"/>
                
                <TextBlock Text="Kargo Ücreti: " FontWeight="Bold"/>
                <TextBlock x:Name="txtShippingFee" Margin="5,0,20,0"/>

                <TextBlock Text="İndirim/Zam Tutarı: " FontWeight="Bold"/>
                <TextBlock x:Name="txtAdjustmentPercentage" Margin="5,0,20,0"/>

                <TextBlock Text="Toplam Tutar: " FontWeight="Bold"/>
                <TextBlock x:Name="txtTotal" Margin="5,0,20,0"/>
            </WrapPanel>
        </StackPanel>

        <Button Grid.Row="1" HorizontalAlignment="Right" Width="40" Height="40" Margin="40,10,30,0"
            Background="Transparent" BorderThickness="0" Cursor="Hand"
            ToolTip="Proforma PDF Oluştur"
            Click="btnGeneratePdf_Click">
            <Image Source="/Assets/pdf.png" Width="35" Height="40"/>
        </Button>

        <!-- ÜRÜNLER TABLOSU -->
        <DataGrid Grid.Row="2" x:Name="dgOrderItems" AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="20,10,20,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ParcaAdi}" Width="*"/>
                <DataGridTextColumn Header="Adet" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice}" Width="100"/>
                <DataGridTextColumn Header="Toplam" Binding="{Binding Total}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
