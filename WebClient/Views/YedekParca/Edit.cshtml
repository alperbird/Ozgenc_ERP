@using EntityLayer.Entities;
@model EntityLayer.Entities.Product
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Parça Güncelle";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedMachines = ViewBag.SelectedMachines as List<int>;
}

<div class="content-wrapper p-4">
    <h3 class="mb-4 text-primary">Parça Bilgilerini Güncelle</h3>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Parça Adı</label>
                <input asp-for="ParcaAdi" class="form-control" />
                <span asp-validation-for="ParcaAdi" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label">Fiyat (TL)</label>
                <input asp-for="FiyatTL" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Fiyat (EUR)</label>
                <input asp-for="FiyatEUR" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Sınıf</label>
                <select asp-for="Sinif" class="form-select" asp-items="ViewBag.Sinif">
                    <option value="">-- Sınıf Seçin --</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label">Fotoğraf</label><br />
                @if (!string.IsNullOrEmpty(Model.ResimYolu))
                {
                    <img src="~/YedekParcaAssets/@Model.ResimYolu" style="height: 80px;" class="img-thumbnail mb-2" />
                }
                <input type="file" name="foto" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Bağlı Makineler</label>
                <div class="border p-2 rounded" style="max-height: 160px; overflow-y: auto;">
                    @foreach (SelectListItem item in ViewBag.Machines)
                    {
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="selectedMachines"
                                   value="@item.Value"
                                   id="machine_@item.Value"
                            @(selectedMachines.Contains(Convert.ToInt32(item.Value)) ? "checked" : "") />
                            <label class="form-check-label" for="machine_@item.Value">@item.Text</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Kaydet
            </button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>