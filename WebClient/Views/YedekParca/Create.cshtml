@model EntityLayer.Entities.Product;

@{
    ViewData["Title"] = "Yedek Parça Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content p-3">
        <h2>Yeni Parça Ekle</h2>
        <form asp-action="Create" method="post" enctype="multipart/form-data
">
            <div class="mb-3">
                <label class="form-label">Makineler</label>
                <div style="max-height: 200px; overflow-y: auto; border: 1px solid #ccc; border-radius: 5px; padding: 10px;">
                    @if (ViewBag.Machines != null)
                    {
                        foreach (var item in (List<SelectListItem>)ViewBag.Machines)
                        {
                            <div class="form-check">
                                <input type="checkbox" name="selectedMachines" value="@item.Value" class="form-check-input" id="m_@item.Value" />
                                <label class="form-check-label" for="m_@item.Value">@item.Text</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning">Makine listesi yüklenemedi.</div>
                    }
                </div>
            </div>


            <div class="mb-3">
                <label class="form-label">Parça Adı</label>
                <input asp-for="ParcaAdi" class="form-control" />
                <span asp-validation-for="ParcaAdi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Sınıf</label>
                <select asp-for="Sinif" class="form-select" asp-items="ViewBag.Sinif">
                    <option value="">-- Sınıf Seçin --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Fiyat (TL)</label>
                <input asp-for="FiyatTL" class="form-control" type="number" step="0.01" />
            </div>

            <div class="mb-3">
                <label class="form-label">Fiyat (EUR)</label>
                <input asp-for="FiyatEUR" class="form-control" type="number" step="0.01" />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Aciklama" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Fotoğraf Yükle</label>
                <input type="file" name="foto" class="form-control" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i>EKLE</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </section>
</div>
