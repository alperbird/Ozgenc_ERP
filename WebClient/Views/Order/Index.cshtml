@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using EntityLayer.DTOs
@model List<OrderListDto>
@{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int maxPagesToShow = 5;

    int startPage = Math.Max(1, currentPage - maxPagesToShow / 2);
    int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

    // başta azsa ayarla
    if (endPage - startPage < maxPagesToShow - 1)
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
}

<div class="content-wrapper p-3">
    <div class="content-header">
        <h1 class="mb-4">Sipariş Geçmişi</h1>
    </div>
    <form method="get" class="row mb-3">
        <div class="col-md-4">
            <input type="date" name="startDate" class="form-control"
                   value="@ViewBag.StartDate" placeholder="Başlangıç Tarihi" />
        </div>
        <div class="col-md-4">
            <input type="date" name="endDate" class="form-control"
                   value="@ViewBag.EndDate" placeholder="Bitiş Tarihi" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">Tarihe Göre Filtrele</button>
        </div>
    </form>
    <div class="card">
        <div class="card-body table-responsive p-0">
            <table class="table table-hover text-nowrap text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Müşteri</th>
                        <th>Sipariş Tarihi</th>
                        <th>Toplam Tutar</th>
                        <th>Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        int count = 1;
                        foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.Customer.CustomerName</td>
                                <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                                <td>@order.TotalPrice.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IE"))</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@Url.Action("Detail", "Order", new { id = order.Id })">
                                        Detay
                                    </a>
                                </td>
                            </tr>
                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">Kayıt bulunamadı</td>
                        </tr>
                    }
                </tbody>
            </table>
            <nav aria-label="Sayfalar" class="mt-3">
                <ul class="pagination justify-content-center">

                    <!-- İlk sayfa -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = 1 })">« İlk</a>
                    </li>

                    <!-- Geri -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1 })">&lt; Geri</a>
                    </li>

                    <!-- Sayfa numaraları -->
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }

                    <!-- İleri -->
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1 })">İleri &gt;</a>
                    </li>

                    <!-- Son sayfa -->
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = totalPages })">Son »</a>
                    </li>
                </ul>

                <div class="text-center text-muted mt-2">
                    Sayfa @currentPage / @totalPages
                </div>
            </nav>
        </div>
    </div>
</div>