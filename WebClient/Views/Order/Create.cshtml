    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using Newtonsoft.Json
@using EntityLayer.DTOs
@model OrderCreateDto
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}
<div class="container mt-4">
    <h2>Sipariş Oluştur</h2>

    <form asp-action="Create" method="post">
        <div class="form-group">
            <label for="orderType">Sipariş Türü</label>
            <select id="orderType" class="form-control">
                <option value="yurtici">Yurt İçi</option>
                <option value="yurtdisi">Yurt Dışı</option>
            </select>
        </div>

        <div class="form-group">
            <label for="CustomerId">Müşteri</label>
            <select id="customerSelect" name="CustomerId" class="form-control select2">
                <option value="">-- Müşteri Seçin --</option>
                @foreach (var c in ViewBag.Customers as List<CustomerDto>)
                {
                    <option value="@c.Id" data-country="@c.CountryName">
                        @c.CustomerName (@c.CountryName)
                    </option>
                }
            </select>

        </div>

        <div id="orderItemsContainer">
            <div class="order-item border p-3 mb-2">
                <div class="row">
                    <div class="col-md-3">
                        <label>Ürün</label>
                        <select name="OrderItems[0].ProductId" class="form-control select2-product">
                            <option value="">-- Parça Seç --</option>
                            @foreach (var p in ViewBag.Products as List<ProductDto>)
                            {
                                <option value="@p.Id">@p.ParcaAdi</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label>Adet</label>
                        <input type="number" name="OrderItems[0].Quantity" value="1" class="form-control" min="1" max="999" required />
                    </div>
                    <div class="col-md-3">
                        <label>Fiyat (EUR)</label>
                        <input type="number" name="OrderItems[0].UnitPrice" class="form-control" step="0.01" min="0.01" max="9999" required />
                    </div>
                    <div class="col-md-3">
                        <label>Özel Parça Adı (opsiyonel)</label>
                        <input type="text" name="OrderItems[0].CustomProductName" class="form-control" placeholder="Varsayılan yerine yazılacak" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="button" class="btn btn-danger remove-item">−</button>
                    </div>
                </div>
            </div>
        </div>

        <button type="button" class="btn btn-secondary mb-3" id="addItem">+ Kalem Ekle</button>

        <div class="form-group">
            <label for="ShippingFee">Kargo Ücreti (€)</label>
            <input type="number" class="form-control" name="ShippingFee" step="0.01" min="0" />
        </div>

        <div class="form-group">
            <label for="AdjustmentType">İndirim / Zam</label>
            <select name="AdjustmentType" class="form-control">
                <option value="0">İndirim</option>
                <option value="1">Zam</option>
            </select>
        </div>

        <div class="form-group">
            <label for="AdjustmentPercentage">Oran (%)</label>
            <input type="number" name="AdjustmentPercentage" class="form-control" value="0" min="0" max="100" />
        </div>

        <button type="submit" class="btn btn-success">Siparişi Kaydet</button>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        const allProducts = @Html.Raw(JsonConvert.SerializeObject(ViewBag.Products));
        const allCustomers = @Html.Raw(JsonConvert.SerializeObject(ViewBag.Customers));
        let index = $('#orderItemsContainer .order-item').length;

        $(document).ready(function () {
            $('.select2').select2();
            bindProductChangeEvents();
            bindCustomerFilter();
        $('#orderType').trigger('change');
        $('.product-select').trigger('change');

            $('#addItem').click(function () {
                const itemHtml = `
                <div class="order-item border p-3 mb-2">
                    <div class="row">
                        <div class="col-md-3">
                            <label>Ürün</label>
                            <select name="OrderItems[${index}].ProductId" class="form-control product-select select2-product">
                                <option value="" disabled selected>-- Parça Seç --</option>
                                ${allProducts.map(p => `<option value="${p.Id}">${p.ParcaAdi}</option>`).join('')}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label>Adet</label>
                            <input type="number" name="OrderItems[${index}].Quantity" value="1" class="form-control" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label>Fiyat (EUR)</label>
                            <input type="number" name="OrderItems[${index}].UnitPrice" class="form-control price-input" step="0.01" />
                        </div>
                        <div class="col-md-3">
                            <label>Özel Parça Adı</label>
                            <input type="text" name="OrderItems[${index}].CustomProductName" class="form-control custom-name-input" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-danger remove-item">−</button>
                        </div>
                    </div>
                </div>`;

                $('#orderItemsContainer').append(itemHtml);
                $('.select2-product').select2({ placeholder: "-- Parça Seç --" });
                index++;

                bindProductChangeEvents();
            });

            $(document).on('click', '.remove-item', function () {
                $(this).closest('.order-item').remove();
            });
        });

        function bindProductChangeEvents() {
            $('.product-select').off('change').on('change', function () {
                const selectedId = parseInt($(this).val());
                const parent = $(this).closest('.order-item');
                const selectedProduct = allProducts.find(p => p.Id === selectedId);

                if (selectedProduct) {
                    parent.find('.price-input').val(selectedProduct.FiyatEUR);
                    parent.find('.custom-name-input').val(selectedProduct.ParcaAdi);
                } else {
                    parent.find('.price-input').val('');
                    parent.find('.custom-name-input').val('');
                }
            });

            $('.product-select').select2({ placeholder: "Parça Seç" });
        }

        function bindCustomerFilter() {
            $('#orderType').on('change', function () {
                const type = $(this).val();
                const $customerSelect = $("#customerSelect");
                $customerSelect.empty().append(`<option value="">-- Müşteri Seçin --</option>`);

                const filtered = type === "yurtici"
                    ? allCustomers.filter(c => c.CountryName?.toLowerCase() === "türkiye")
                    : allCustomers.filter(c => c.CountryName?.toLowerCase() !== "türkiye");

                filtered.forEach(c => {
                    $customerSelect.append(
                        $("<option>").val(c.Id).text(`${c.CustomerName} (${c.CountryName})`)
                    );
                });

                $customerSelect.val(null).trigger("change");
            });

                $('form').submit(function () {
            $('.order-item').each(function (i) {
                $(this).find('select').attr('name', `OrderItems[${i}].ProductId`);
                $(this).find('input[name$=".Quantity"]').attr('name', `OrderItems[${i}].Quantity`);
                $(this).find('input[name$=".UnitPrice"]').attr('name', `OrderItems[${i}].UnitPrice`);
                $(this).find('input[name$=".CustomProductName"]').attr('name', `OrderItems[${i}].CustomProductName`);
            });
        });

       
    }
        
    </script>
}


