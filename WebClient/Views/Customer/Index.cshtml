@using EntityLayer.Entities;
@model PagedResult<EntityLayer.Entities.Customer>
@{
    ViewData["Title"] = "Müşteriler";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int startPage = Math.Max(1, Model.PageNumber - 2);
    int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 4);
}

<div class="content-wrapper">
    <section class="content-header">
        <h1>Müşteriler</h1>
    </section>

    <section class="content pt-2 px-3">
        <div class="card">
            <div class="card-body">
                <div class="mb-3 text-end">
                    <a href="@Url.Action("Create", "Customer")" class="btn btn-outline-success">
                        <i class="fas fa-plus"></i> Müşteri Ekle
                    </a>
                </div>

                <table class="table table-bordered table-hover text-center">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Ad</th>
                            <th>Ülke</th>
                            <th>Adres</th>
                            <th>Teslimat Adresi</th>
                            <th>İletişim</th>
                            <th>Email</th>
                            <th>Telefon</th>
                            <th>Vergi No</th>
                            <th>Düzenle</th>
                            <th>Sil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Items)
                        {
                            <tr>
                                <td>@m.Id</td>
                                <td>@m.CustomerName</td>
                                <td>@m.CountryName.CountryName</td>
                                <td>@m.Address</td>
                                <td>@m.DeliveryAddress</td>
                                <td>@m.Contact</td>
                                <td>@m.Email</td>
                                <td>@m.PhoneNumber</td>
                                <td>@m.TaxNo</td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a href="@Url.Action("Edit", "Customer", new { id = m.Id })"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Düzenle">
                                            <i class="fas fa-pen fa-lg"></i> Düzenle
                                        </a>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Sil"
                                                onclick="showDeletePopup(@m.Id, '@m.CustomerName')">
                                            <i class="fas fa-trash fa-lg"></i> Sil
                                        </button>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>

                <nav class="mt-3">
                    <ul class="pagination justify-content-center">
                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = 1 })#pagedown">İlk Sayfa</a>
                            </li>
                        }

                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1 })#pagedown">&laquo;</a>
                            </li>
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i })#pagedown">@i</a>
                            </li>
                        }

                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1 })#pagedown">&raquo;</a>
                            </li>
                        }

                        <!-- Ekstra: Son Sayfa Butonu -->
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages })#pagedown">Son Sayfa</a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        </div>
    </section>
</div>
<div id="deletePopup" class="modal d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 justify-content-center align-items-center">
    <div class="bg-white p-4 rounded shadow" style="width: 400px;">
        <h5 class="text-danger">Silme Onayı</h5>
        <p id="deleteText">Bu parçayı silmek istediğinize emin misiniz?</p>
        <form id="deleteForm" method="post">
            <input type="hidden" name="id" id="deleteId" />
            <button type="submit" class="btn btn-danger me-2">Sil</button>
            <button type="button" class="btn btn-secondary" onclick="closeDeletePopup()">İptal</button>
        </form>
    </div>
</div>
<script>
    function showDeletePopup(id, name) {
        document.getElementById("deleteId").value = id;
        document.getElementById("deleteText").innerText = `'${name}' adlı müşteriyi silmek istediğinize emin misiniz?`;
        document.getElementById("deleteForm").action = `/Customer/Delete/${id}`;
        document.getElementById("deletePopup").classList.remove("d-none");
        document.getElementById("deletePopup").classList.add("d-flex");
    }

    function closeDeletePopup() {
        document.getElementById("deletePopup").classList.remove("d-flex");
        document.getElementById("deletePopup").classList.add("d-none");
    }
</script>