<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Özgenç ERP</title>

    <!-- AdminLTE 4 Styles -->
    <link rel="stylesheet" href="~/adminlte/css/adminlte.css" />
    <link rel="stylesheet" href="~/adminlte/assets/icons/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="layout-fixed layout-navbar-fixed sidebar-collapse" data-lte-toggle-state="manual">
    <div class="app-wrapper">

        <!-- Navbar -->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a href="/" class="nav-link">Anasayfa</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <span class="nav-link font-weight-bold">ÖZGENÇ ERP</span>
                    </li>
                </ul>
            </div>
        </nav>
        <!-- /.navbar -->
        <!-- Sidebar -->
        <aside class="app-sidebar bg-dark text-white">
            <div class="sidebar-brand d-flex align-items-center justify-content-center py-3">
                <span class="fs-5 fw-semibold text-white">Menü</span>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-lte-toggle="treeview" role="menu">
                        <!-- Yedek Parçalar -->
                        <li class="nav-item">
                            <a href="/YedekParca" class="nav-link text-white">
                                <i class="bi bi-gear-wide-connected"> </i>
                                <p class="text-white"> Yedek Parçalar</p>
                            </a>
                        </li>

                        <!-- Müşteriler -->
                        <li class="nav-item">
                            <a href="/Customer" class="nav-link text-white">
                                <i class="bi bi-people-fill"> </i>
                                <p class="text-white"> Müşteriler</p>
                            </a>
                        </li>

                        <!-- Siparişler (treeview) -->
                        <li class="nav-item menu-open">
                            <a href="/Order" class="nav-link bg-secondary text-white">
                                <i class="bi bi-basket"></i>
                                <p class="text-white">
                                    Siparişler
                                    <i class="nav-arrow bi bi-chevron-right text-white"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/Order/Index" class="nav-link text-white">
                                        <p class="text-white">Sipariş Geçmişi</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Order/Create" class="nav-link text-white">
                                        <p class="text-white">Sipariş Oluştur</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- /.sidebar -->
        <!-- Main Content -->
        <main class="app-main">
            <div class="app-content p-4">
                @RenderBody()
            </div>
        </main>

        <!-- Footer -->
        <footer class="app-footer text-center">
            <strong>&copy; 2025 - Özgenç ERP Sistemi</strong> Tüm Hakları Saklıdır.
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/adminlte/assets/js/jquery/jquery.min.js"></script>
    <script src="~/adminlte/assets/js/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/js/adminlte.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
          const toggleBtn = document.querySelector('[data-lte-toggle="sidebar"]');

          if (toggleBtn) {
            toggleBtn.addEventListener("click", function (e) {
              e.preventDefault();
              const html = document.querySelector("body");

              if (html.classList.contains("sidebar-open")) {
                html.classList.remove("sidebar-open");
                html.classList.add("sidebar-collapse");
              } else {
                html.classList.remove("sidebar-collapse");
                html.classList.add("sidebar-open");
              }
            });
          }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
