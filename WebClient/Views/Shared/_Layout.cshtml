<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Özgenç ERP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- AdminLTE Styles -->
    <link rel="stylesheet" href="~/adminlte/css/adminlte.css" />
    <link rel="stylesheet" href="~/adminlte/assets/icons/fontawesome/css/all.min.css" />
</head>
<body class="sidebar-mini layout-fixed layout-navbar-fixed">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/" class="nav-link">Ana Sayfa</a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-toggle="dropdown" href="#">
                        <img src="~/adminlte/assets/img/user2-160x160.jpg" alt="User" class="img-size-32 mr-2 img-circle">
                        <span>Admin</span>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- /Navbar -->
        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="/" class="brand-link">
                <img src="~/adminlte/assets/img/credit/logo.png" alt="Ozgenç Logo" class="brand-image img-circle elevation-3" style="height: 35px; width: auto; opacity: .8;">

                <span class="brand-text font-weight-light">ERP Sistemi</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="/YedekParca" class="nav-link">
                                <i class="nav-icon fas fa-cogs"></i>
                                <p>Yedek Parçalar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Customer")" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Müşteriler</p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>
        <!-- /Sidebar -->
        <!-- Content Wrapper -->
        <div class="content-wrapper p-3">
            @RenderBody()
        </div>

        <!-- Footer -->
        <footer class="main-footer text-center">
            <strong>&copy; 2025 - Özgenç ERP Sistemi</strong> Tüm Hakları Saklıdır.
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/adminlte/assets/js/jquery/jquery.min.js"></script>
    <script src="~/adminlte/assets/js/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/js/adminlte.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

